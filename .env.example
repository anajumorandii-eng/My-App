# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# Configure this via the Secrets panel in the AI Studio UI (or as a Cloud Run
# environment variable / secret if deployed outside AI Studio).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth Credentials for Calendar Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Select the provider used by the provider-neutral AI layer.
AI_PROVIDER="omniroute"

# OmniRoute is OpenAI Chat Completions-compatible, exposed through the
# Tailscale hostname. Store OMNIROUTE_API_KEY in Secret Manager; never
# commit its real value.
OMNIROUTE_API_KEY=""
OMNIROUTE_BASE_URL="https://your-private-omniroute-host/v1"
# HTTP proxy exposed by the Tailscale userspace sidecar in Cloud Run.
OMNIROUTE_PROXY_URL="http://localhost:1055"
# Deep/fast combo routing: reasoning-heavy tasks use the deep model,
# lighter tasks (tips, examples, podcast scripts) use the fast one.
AI_DEEP_MODEL="juju-deep-v1"
AI_FAST_MODEL="juju-fast-v1"

# Gemini remains available as a fallback by setting AI_PROVIDER="gemini".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-pro-preview"

# Firebase Auth protects the AI/admin routes; ADMIN_EMAILS grants /api/admin access.
FIREBASE_PROJECT_ID="gen-lang-client-0346381323"
ADMIN_EMAILS="seu-email@gmail.com"

AI_TIMEOUT_MS="150000"
AI_RATE_LIMIT_MAX="30"
AI_RATE_LIMIT_WINDOW_MS="600000"
AI_DAILY_LIMIT="100"
# Use "firestore" in production so quotas survive restarts and multiple instances.
AI_QUOTA_STORE="memory"
# Use "firestore" in production for aggregate metrics without prompt content.
AI_METRICS_STORE="memory"
# Set to "firestore" to ground content-explanation with real apostila
# excerpts (see scripts/split-chapters.py + scripts/upload-apostila-references.ts).
# Leave unset to skip grounding entirely.
AI_APOSTILA_REFERENCES=""

# Optional: fill with the OmniRoute prices to include estimatedCostUsd in logs.
AI_DEEP_INPUT_USD_PER_MILLION="0"
AI_DEEP_OUTPUT_USD_PER_MILLION="0"
AI_FAST_INPUT_USD_PER_MILLION="0"
AI_FAST_OUTPUT_USD_PER_MILLION="0"

# Web Push for review reminders (generate once with `npx web-push generate-vapid-keys`).
# Store VAPID_PRIVATE_KEY in Secret Manager; never commit its real value.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:seu-email@gmail.com"
# Shared secret the Cloud Scheduler job sends as the X-Cron-Secret header
# when calling POST /api/push/send-review-reminders. Store in Secret Manager.
CRON_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth Credentials for Calendar Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

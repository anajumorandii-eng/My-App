# Select the provider used by the provider-neutral AI layer.
AI_PROVIDER="omniroute"

# OmniRoute exposes an OpenAI-compatible API through the Tailscale hostname.
# Store OMNIROUTE_API_KEY in Secret Manager; never commit its real value.
OMNIROUTE_API_KEY=""
OMNIROUTE_BASE_URL="https://your-private-omniroute-host/v1"
# HTTP proxy exposed by the Tailscale userspace sidecar in Cloud Run.
OMNIROUTE_PROXY_URL="http://localhost:1055"
# Reliable default. To trial the faster combo, set this to juju-fast-v1.
OMNIROUTE_MODEL="juju-deep-v1"

# Gemini remains available as a fallback by setting AI_PROVIDER="gemini".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-pro-preview"

AI_TIMEOUT_MS="60000"
AI_RATE_LIMIT_MAX="30"
AI_RATE_LIMIT_WINDOW_MS="600000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth Credentials for Calendar Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

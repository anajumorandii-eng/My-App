/** Reproduce coverage and maintenance checks without rewriting the question bank. */
import assert from 'node:assert/strict';
import { readFile, writeFile, mkdir } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { mockTopics } from '../src/data/mockData';
import { auditEnemCoverage } from '../src/lib/enemCoverageAudit';
import { loadEnemEditorialClassifications, loadEnemEditorialDeferrals, enemReviewBatchPaths } from './lib/enemEditorialClassifications';

const paths={bank:'public/questions.json',manifest:'scripts/data/enem-completo-2018-2025/manifest.json',imported:'scripts/data/enem-completo-2018-2025/questions.json'};
const raw=await Promise.all(Object.values(paths).map(path=>readFile(path,'utf8')));
const [bank,manifest,imported]=raw.map(content=>JSON.parse(content));
assert.deepEqual(manifest.years, [2018,2019,2020,2021,2022,2023,2024,2025]);
assert.equal(manifest.positions.length, 1440);
for (const year of manifest.years) assert.equal(manifest.positions.filter((position: {year:number}) => position.year === year).length,180);
const result=auditEnemCoverage(bank,mockTopics,manifest.positions,await loadEnemEditorialClassifications(mockTopics),imported,await loadEnemEditorialDeferrals());
const additionalInputs: Record<string, {path:string;sha256:string}> = {};
for (const path of ['src/data/mockData.ts', ...await enemReviewBatchPaths(), ...new Set([...await loadEnemEditorialClassifications(mockTopics)].map(([,row])=>row.source))]) additionalInputs[path]={path,sha256:createHash('sha256').update(await readFile(path)).digest('hex')};
const report={asOf:'2026-11-04',scope:'ENEM 2018–2025, aplicação regular impressa, cadernos amarelos, opção Inglês; currículo principal por questão, sem dupla contagem de habilidades secundárias.',inputs:Object.fromEntries(Object.keys(paths).map((key,index)=>[key,{path:paths[key as keyof typeof paths],sha256:createHash('sha256').update(raw[index]).digest('hex')}])),additionalInputs,...result};
const directory='docs/auditoria-cobertura-enem-2026-11-04';await mkdir(directory,{recursive:true});
await writeFile(`${directory}/auditoria.json`,JSON.stringify(report,null,2)+'\n');
const csv=(rows:unknown[][])=>'\ufeff'+rows.map(row=>row.map(cell=>'"'+String(cell??'').replace(/"/g,'""')+'"').join(';')).join('\n')+'\n';
await writeFile(`${directory}/capitulos.csv`,csv([['Matéria','Tópico','Capítulo','Total','Válidas','Anuladas','Classificação automática sem revisão posterior','Edições com questão válida'],...result.coverage.flatMap(t=>t.chapters.map(c=>[t.subject,t.topic,c.chapter,c.total,c.valid,c.annulled,c.automaticPending,c.years.join(', ')]))]));
await writeFile(`${directory}/fila-revisao.csv`,csv([['ID','Ano','Número canônico amarelo','Matéria','Tópico','Capítulo','Motivos','Revisão existente','Motivo de adiamento'],...result.queue.map(q=>[q.id,q.year,q.number,q.subject,q.topicId,q.chapter,q.reasons.join(', '),q.source,q.deferredReason])]));
const counts=result.summary;
const md=['# Auditoria de cobertura — ENEM 2018–2025','',report.scope,'',`**${counts.positions} posições; ${counts.valid} válidas e ${counts.annulled} anuladas.** ${counts.representedTopics}/${counts.topics} tópicos do currículo possuem registros. ${counts.uncoveredChapters}/${counts.chapters} capítulos não possuem questão válida classificada neste corpus.`,'','Contagem de registros não comprova variedade de habilidades, precisão editorial ou domínio do estudante. Um item tem um tópico principal; pré-requisitos e habilidades secundárias não são contabilizados novamente. Ausência de item neste recorte não significa ausência no ENEM nem obrigação de ampliar esse tópico.','', '## Integridade e manutenção','',`- ${result.errors.length} violações estruturais; ${result.duplicateContent.length} grupos com mesmo enunciado e alternativas após normalização; ${result.sharedStems.length} grupos com enunciado idêntico para conferência. Isso não substitui revisão semântica individual.`,`- ${result.sourceDrift.length} classificações divergentes entre o lote de importação alinhado e o banco publicado.`,`- ${counts.editoriallyReviewed} questões têm classificação editorial versionada; ${counts.editorialReservations} mantêm ressalva e ${counts.deferred} aguardam decisão de taxonomia/fonte. Revisão registrada não significa validação semântica definitiva.`,`- ${counts.automaticPending} questões ainda têm classificação de origem lexical automática, sem revisão posterior encontrada nos arquivos editoriais consultados.`,`- ${result.missingChapters.length} questões permanecem sem capítulo, com ressalva editorial em vez de vínculo artificial.`,`- ${result.outsideArea.length} classificações curriculares atravessam a área oficial da prova; esses casos exigem evidência, não exclusão automática.`,'','## Classificação curricular por matéria','', '|Matéria|Total|Válidas|Anuladas|','|---|---:|---:|---:|',...result.subjects.map(s=>`|${s.subject}|${s.total}|${s.valid}|${s.annulled}|`),'','## Área oficial da prova','', '|Área|Total|Válidas|Anuladas|','|---|---:|---:|---:|',...result.areas.map(s=>`|${s.area}|${s.total}|${s.valid}|${s.annulled}|`),'','## Tópicos sem questão válida neste recorte','',...result.coverage.filter(t=>!t.valid).map(t=>`- ${t.subject} — ${t.topic}.`),'','## Tópicos com uma a quatro questões válidas','',...result.coverage.filter(t=>t.valid>0&&t.valid<5).sort((a,b)=>a.valid-b.valid).map(t=>`- ${t.subject} — ${t.topic}: ${t.valid} válidas (${t.automaticPending} classificações automáticas pendentes).`),'','## Cobertura completa por tópico','', '|Matéria|Tópico|Total|Válidas|Automáticas pendentes|Capítulos sem válidas|','|---|---|---:|---:|---:|---:|',...result.coverage.map(t=>`|${t.subject}|${t.topic}|${t.total}|${t.valid}|${t.automaticPending}|${t.chapters.filter(c=>!c.valid).length}/${t.chapters.length}|`),'','## Arquivos e reprodução','', '- [Revisão da fila: método, decisões e pendências](REVISAO-EDITORIAL.md).', '- [Decisões, correções confirmadas e prioridades de ampliação](DECISOES-E-PRIORIDADES.md).', '- [Capítulos e subtópicos: contagem integral](capitulos.csv).','- [Fila de conferência por questão](fila-revisao.csv): lacunas taxonômicas primeiro, depois classificações automáticas; uma fila de trabalho, não uma lista de erros comprovados.','- [Relatório estruturado e hashes das entradas](auditoria.json).','', '`npx tsx scripts/audit-enem-coverage.mts`',''];
await writeFile(`${directory}/README.md`,md.join('\n'));
console.log(JSON.stringify(result.summary));console.log('Duplicidades textuais:',result.duplicateContent.length,'; lote divergente:',result.sourceDrift.length,'; fila:',result.queue.length);
if(result.errors.length||result.sourceDrift.length)process.exitCode=1;

  "rules": [
    {
      "id": "phase1",
      "title": "1ª fase: 80 questões em 5 horas",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "01/11/2026. Oitenta questões de múltipla escolha, cinco alternativas e uma correta; cada acerto vale um ponto bruto (máximo 80).",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 5,
      "implication": "Simular 80 questões em 300 minutos, incluindo revisão e preenchimento; não comparar acertos absolutos de 90 e 80 questões sem normalizar."
    },
    {
      "id": "phase2",
      "title": "2ª fase: dois dias de quatro horas",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "06 e 07/12/2026. Dia 1: dez questões discursivas de Português (interpretação, gramática e literatura) e redação. Dia 2: doze questões de duas a quatro disciplinas da carreira.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 7,
      "implication": "Treinar dez respostas e uma redação em quatro horas; em Medicina, treinar doze respostas B/F/G/Q no dia seguinte."
    },
    {
      "id": "interdisciplinarity",
      "title": "Programa e interdisciplinaridade já aplicáveis",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "Art.4 da Resolução CoG9008 determina questões interdisciplinares. O programa contempla Arte, Biologia, Educação Física, Filosofia, Física, Geografia, História, Inglês, Matemática, Português, Química e Sociologia.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-resolucao-DOE.pdf",
      "page": 2,
      "implication": "Identificar a operação central e relacionar somente conceitos necessários; Arte e Educação Física já integram o programa de 2027 e não devem ser adiadas para 2028."
    },
    {
      "id": "essay-choice",
      "title": "Redação: escolher e assinalar uma proposta",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "A proposta poderá solicitar mais de um gênero textual; o candidato deve optar por um deles na folha de redação. Não assinalar a escolha implica nota zero. Não existe obrigação de produzir todos os gêneros oferecidos.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 10,
      "implication": "Treinar leitura de comando, interlocutor, finalidade, suporte e estrutura do gênero; conferir a opção marcada antes da entrega."
    },
    {
      "id": "essay-rubric",
      "title": "Quatro critérios de redação",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "Tema/coletânea/autoria peso3; atendimento da modalidade textual peso2; coesão/coerência/progressão peso3; correção gramatical/convenções/vocabulário peso2.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 11,
      "implication": "Revisar tanto conteúdo e progressão quanto o atendimento específico ao gênero escolhido."
    },
    {
      "id": "weights",
      "title": "Pesos de Medicina",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "Sem competências específicas, NFC=(F1+D1+D2)/3, com F1 normalizada a100; resultado convertido a1000. D1: Português50+Redação50; D2:100 e questões de igual valor.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 13,
      "implication": "Cada dia da2ªfase tem o mesmo peso global da1ªfase; uma disciplina entre quatro de D2 equivale a25% desse dia, cerca de8,33% da nota final; redação cerca de16,67%."
    },
    {
      "id": "elimination",
      "title": "Mínimos eliminatórios não são nota de corte",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "Menos de24 acertos (30% de80) elimina. Art.13 §2: zero na redação, no conjunto das questões de Português OU em D2 elimina. Convocação: quatro vezes as vagas por carreira/modalidade, mínimo10 quando habilitados suficientes, incluindo empatados no limite.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-resolucao-DOE.pdf",
      "page": 6,
      "implication": "Não interpretar24 como meta competitiva para Medicina; evitar abandonar Português ou redação mesmo com bom desempenho em Natureza."
    },
    {
      "id": "partial-credit",
      "title": "Correção discursiva",
      "appliesTo": "FUVEST 2027 — ingresso em 2027; provas em 2026",
      "description": "Questões recebem de zero a cinco, depois normalização. No mínimo duas avaliações independentes; respostas válidas alternativas são consideradas após uniformização da banca.",
      "sourceUrl": "https://www.fuvest.br/wp-content/uploads/fuvest2027-guia-provas.pdf",
      "page": 9,
      "implication": "Explicitar relações, unidades e justificativas pedidas em cada subitem; preservar passos válidos, sem inventar um critério de pontos que o guia não publica."
    },
    {
